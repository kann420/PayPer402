{
  "name": "payper402",
  "version": "0.0.0",
  "private": true,
  "description": "Pay-per-call for AI agents over HTTP 402, settled with PayPal.",
  "license": "MIT",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*",
    "spikes/*"
  ],
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "payper402": "apps/agent/bin/payper402.mjs"
  },
  "scripts": {
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "vitest run",
    "demo": "npm run demo -w apps/agent --",
    "payper402": "npm run --silent payper402 -w apps/agent --",
    "dev:stack": "npm run dev:stack -w apps/web --",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "esbuild": "0.28.2",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vitest": "^5.0.5"
  }
}
