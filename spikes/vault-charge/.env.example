# From developer.paypal.com -> Apps & Credentials -> Sandbox tab -> your app
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=

# Amount (USD) to charge after the wallet is saved
CHARGE_AMOUNT=1.00

# Usage pattern declared to PayPal when the wallet is saved.
# IMMEDIATE is what PayPal's main example uses. PayPer402 itself uses
# UNSCHEDULED_POSTPAID (use first, batch and charge later).
USAGE_PATTERN=IMMEDIATE

# Local port that receives the redirect after the payer approves on PayPal
PORT=8787

# "on" also sends stored_credential (payment_initiator=MERCHANT) when charging.
# Off by default because PayPal's main example only sends vault_id.
STORED_CREDENTIAL=off

# Only set this if PayPal rejects a localhost return_url (for example an https ngrok URL)
# RETURN_BASE_URL=https://xxxx.ngrok-free.app
