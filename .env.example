# Copy to .env and fill in. Never commit .env.

# PayPal sandbox REST app (developer.paypal.com -> Apps & Credentials -> Sandbox).
# The app must be linked to a US sandbox Business account with "Save payment methods" enabled.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Optional. Defaults to the sandbox host; the live host is always refused.
# PAYPAL_API_BASE=https://api-m.sandbox.paypal.com

# Anthropic API (demo agent and dashboard assistant).
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
# Optional. Enables the agent's decision layer (Jev, TypeSafe). Task text is sent to TypeSafe.
# TYPESAFE_API_KEY

# Optional. AG Studio runs without a key (with a watermark).
# AG_STUDIO_LICENSE_KEY=

# Facilitator (apps/facilitator).
# External base URL of the facilitator, used for the PayPal return and cancel URLs.
PUBLIC_BASE_URL=http://localhost:4020
# 64 hex characters (32 bytes). Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
DATA_ENCRYPTION_KEY=
# At least 32 characters. Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
API_KEY_PEPPER=
# Optional. Without it, /webhooks/paypal answers 503.
# PAYPAL_WEBHOOK_ID=
# Optional. At least 32 characters. Enables POST /v1/admin/demo-operators, which the web app uses
# to create one demo operator per visitor. npm run dev:stack makes one per run when it is unset.
# ADMIN_API_KEY=
# Optional. Where the browser is sent after linking.
# WEB_APP_URL=http://localhost:3000
# Optional, with defaults.
# PORT=4020
# DATABASE_PATH=./data/facilitator.db
# SETTLEMENT_TICK_SECONDS=15
# WALLET_CHECK_INTERVAL_SECONDS=30
# LOG_LEVEL=info

# Demo seller (apps/demo-seller).
# The seller's facilitator key (pp402_sel_...), printed once by the facilitator seed.
SELLER_API_KEY=
# Optional, with defaults.
# SELLER_PORT=4021
# SELLER_PUBLIC_URL=http://localhost:4021
# FACILITATOR_URL=http://localhost:4020

# Agent CLI and MCP server (apps/agent).
# The agent's Ed25519 private key: the raw 32-byte seed in base64url, or a JSON JWK.
AGENT_PRIVATE_KEY=
# Optional, with defaults.
# SELLER_URL=http://localhost:4021
# AGENT_BUDGET=1.00
# AGENT_MAX_PER_CALL=0.10

# Demo command (npm run demo). Optional; the agent key file is created next to the database.
# DEMO_DATABASE_PATH=   (default: <repo>/data/demo.db; an absolute path is safest)

# Web app (apps/web). npm run dev:stack sets the URLs, the admin key and
# the seller key for its own run. When this one is unset, it keeps a generated session secret in
# data/web-session.key, so sessions survive restarts.
# 64 hex characters (32 bytes): the key that seals the session cookie.
WEB_SESSION_SECRET=
# Optional, with defaults. FACILITATOR_URL and SELLER_URL above are shared with the web app.
# WEB_PUBLIC_URL=http://localhost:3000
# Equals the facilitator's ADMIN_API_KEY; needed for the operator demo.
# FACILITATOR_ADMIN_KEY=
# The demo seller's facilitator key (pp402_sel_...); needed for the seller demo.
# WEB_SELLER_API_KEY=
# off turns the decision layer off for web runs, even with TYPESAFE_API_KEY set.
# WEB_DECISION_LAYER=on
# GitHub repository URL; the landing page's repository links are hidden when unset.
# NEXT_PUBLIC_REPO_URL=
# 1 = rate limits key on the first X-Forwarded-For address (behind a trusted proxy only).
# WEB_TRUST_PROXY=0
# Rate limits. New demo operators: per client address per hour, and all clients per day.
# WEB_LIMIT_OPERATORS_PER_HOUR=5
# WEB_LIMIT_OPERATORS_PER_DAY=200
# Agent runs: per demo operator per day, and all operators per hour.
# WEB_LIMIT_RUNS_PER_DAY=20
# WEB_LIMIT_RUNS_PER_HOUR=60
# AI assistant turns: per browser session per hour, and all sessions per day.
# WEB_LIMIT_AI_TURNS_PER_HOUR=120
# WEB_LIMIT_AI_TURNS_PER_DAY=2000
